<Project>
  <!-- Reproducible builds: the same source and SDK (global.json) give byte-identical DLLs, so anyone can check
       a release against the source. On GitHub Actions, local paths are also mapped out of the output. Rebuild
       locally the same way with: dotnet build -c Release -p:ContinuousIntegrationBuild=true -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
