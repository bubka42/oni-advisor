<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the mod's network checks (src/OniAdvisor/NetChecks.cs) on .NET Framework 4.8, outside the game:
       the same code and framework API the mod uses, though not the game's Mono TLS. TEMPORARY. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="..\..\src\OniAdvisor\NetChecks.cs" Link="NetChecks.cs" />
  </ItemGroup>
</Project>
