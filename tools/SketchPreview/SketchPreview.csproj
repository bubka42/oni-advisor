<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the mod's hand-drawn mark shapes (src/OniAdvisor/Sketch.cs) to an SVG, to tune them without
       starting the game. Unity is replaced by the few stand-ins in Shim.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\OniAdvisor\Sketch.cs" Link="Sketch.cs" />
  </ItemGroup>
</Project>
